# Copy this file to .env and fill in real values. .env itself should never be committed.

# Optional. Enables the advisory-only "AI forensic check" (server/verification/aiForensics.js) that
# flags possible visual signs of AI-generation/tampering on uploaded certificate images. This NEVER
# affects a certificate's VERIFIED/NOT_FOUND/NEEDS_REVIEW status — it only adds one extra evidence
# line for faculty to read. If left unset, the check reports itself as "not run" rather than being
# silently skipped or faked. Set ANTHROPIC_API_KEY, GROQ_API_KEY, or both (Anthropic is preferred
# when both are set — set only GROQ_API_KEY if that's the one you have).
ANTHROPIC_API_KEY=
GROQ_API_KEY=

# Optional. Which model the AI forensic check calls, per provider. Defaults shown below if unset.
# AI_FORENSICS_MODEL=claude-sonnet-5
# AI_FORENSICS_GROQ_MODEL=qwen/qwen3.8-27b

# Optional. The first ADMIN account, who approves teacher sign-ups (server/db/seedAdmin.js). Only used
# on first start, when no admin exists yet. If ADMIN_PASSWORD is left unset, a random password is
# generated and printed ONCE in the server console. There is deliberately no default password.
# ADMIN_EMAIL=admin@yourcollege.edu
# ADMIN_PASSWORD=choose-a-strong-password
